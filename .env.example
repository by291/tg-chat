# Generate a local .env with: node scripts/create-local-env.mjs
# Empty required credentials deliberately prevent an insecure default deployment.
TG_CHAT_DATABASE_PASSWORD=
TG_CHAT_CENTRIFUGO_TOKEN_KEY=
TG_CHAT_CENTRIFUGO_API_KEY=
TG_CHAT_S3_ACCESS_KEY=
TG_CHAT_S3_SECRET_KEY=

TG_CHAT_HTTP_PORT=8080
TG_CHAT_S3_PORT=8333
TG_CHAT_PUBLIC_ORIGIN=http://localhost:8080
TG_CHAT_S3_INTERNAL_ENDPOINT=http://seaweedfs:8333
TG_CHAT_S3_PUBLIC_ENDPOINT=http://localhost:8333
TG_CHAT_LOG_LEVEL=info
