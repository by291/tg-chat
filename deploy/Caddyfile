{
	admin off
	auto_https off
	# Upstream failures can log entire requests even when access logging is disabled.
	log {
		format filter {
			wrap json
			fields {
				request delete
			}
		}
	}
}

:80 {
	# Internal callbacks accept only direct secret-authenticated Centrifugo traffic.
	respond /internal/* 404

	# Keep API failures out of the SPA fallback so clients receive the real JSON error.
	@backend path /health/* /api /api/*
	handle @backend {
		reverse_proxy api:8080 {
			header_up X-TG-Client-IP {remote_host}
			transport http {
				dial_timeout 2s
				response_header_timeout 5s
			}
		}
	}

	handle /connection/websocket {
		reverse_proxy centrifugo:8000
	}

	@call_signaling path /rtc /rtc/*
	handle @call_signaling {
		# Check live call ownership before passing any new signaling connection to LiveKit.
		forward_auth api:8080 {
			uri /internal/calls/signaling
		}
		reverse_proxy livekit:7880 {
			# LiveKit must receive the same query credential the application authorized.
			header_up -Authorization
			header_up -Cookie
			transport http {
				dial_timeout 2s
			}
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
