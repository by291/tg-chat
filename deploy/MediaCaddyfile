{
	admin off
	auto_https off
	servers {
		timeouts {
			read_header 10s
			# Cleanup waits longer than an admitted upload and its upstream response.
			read_body 120s
		}
	}
	# Query strings contain bearer signatures.
	log {
		format filter {
			wrap json
			fields {
				request delete
			}
		}
	}
}

:8333 {
	header {
		-Set-Cookie
		X-Content-Type-Options nosniff
		Cache-Control "private, no-store"
	}

	@upload method PUT
	request_body @upload {
		max_size 8388608
	}

	# RustFS serves its control plane on the same listener as S3.
	@control_plane path /rustfs /rustfs/* /minio /minio/*
	respond @control_plane 404
	rewrite /healthz /health/ready

	# Preserve the signed host and keep app cookies away from object storage.
	reverse_proxy http://rustfs:9000 {
		header_up -Cookie
		header_down -Set-Cookie
		transport http {
			dial_timeout 2s
			response_header_timeout 30s
		}
	}
}
