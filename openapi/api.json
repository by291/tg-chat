  "components": {
    "schemas": {
      "Audience": { "type": "string", "enum": ["everyone", "contacts", "nobody"] },
      "AuthResponse": {
        "type": "object",
        "required": ["user", "session", "csrf_token"],
        "properties": {
          "csrf_token": { "type": "string" },
          "session": { "$ref": "#/components/schemas/SessionView" },
          "user": { "$ref": "#/components/schemas/PrivateProfile" }
        }
      },
      "Bootstrap": {
        "type": "object",
        "required": [
          "deployment_id",
          "user",
          "privacy",
          "contacts",
          "blocks",
          "conversations",
          "cursor"
        ],
        "properties": {
          "blocks": { "type": "array", "items": { "$ref": "#/components/schemas/PublicProfile" } },
          "contacts": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/PublicProfile" }
          },
          "conversations": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ConversationView" }
          },
          "cursor": { "type": "string" },
          "deployment_id": { "type": "string", "format": "uuid" },
          "privacy": { "$ref": "#/components/schemas/PrivacySettings" },
          "user": { "$ref": "#/components/schemas/PrivateProfile" }
        }
      },
      "CanonicalMessage": {
        "type": "object",
        "required": [
          "id",
          "conversation_id",
          "author_id",
          "author_name",
          "sequence",
          "version",
          "created_at",
          "is_deleted",
          "interaction_version",
          "is_pinned",
          "reactions",
          "content"
        ],
        "properties": {
          "author_id": { "type": "string", "format": "uuid" },
          "author_name": { "type": "string" },
          "content": { "$ref": "#/components/schemas/MessageContent" },
          "conversation_id": { "type": "string", "format": "uuid" },
          "created_at": { "type": "string", "format": "date-time" },
          "edited_at": { "type": ["string", "null"], "format": "date-time" },
          "expires_at": { "type": ["string", "null"], "format": "date-time" },
          "id": { "type": "string", "format": "uuid" },
          "interaction_version": { "type": "string" },
          "is_deleted": { "type": "boolean" },
          "is_pinned": { "type": "boolean" },
          "reactions": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ReactionView" }
          },
          "reply": { "oneOf": [{ "type": "null" }, { "$ref": "#/components/schemas/ReplyView" }] },
          "sequence": { "type": "string" },
          "service_kind": { "type": ["string", "null"] },
          "version": { "type": "string" }
        }
      },
      "Capabilities": {
        "type": "object",
        "required": [
          "registration_open",
          "email_recovery_available",
          "avatars_available",
          "messaging_available"
        ],
        "properties": {
          "avatars_available": { "type": "boolean" },
          "email_recovery_available": { "type": "boolean" },
          "messaging_available": { "type": "boolean" },
          "registration_open": { "type": "boolean" }
        }
      },
      "CommandAction": {
        "oneOf": [
          {
            "type": "object",
            "required": ["expected_version", "kind"],
            "properties": {
              "content": {
                "oneOf": [{ "type": "null" }, { "$ref": "#/components/schemas/MessageContent" }]
              },
              "expected_version": { "type": "string" },
              "kind": { "type": "string", "enum": ["draft"] },
              "reply": {
                "oneOf": [{ "type": "null" }, { "$ref": "#/components/schemas/ReplyInput" }]
              }
            }
          },
          {
            "type": "object",
            "required": ["through", "kind"],
            "properties": {
              "kind": { "type": "string", "enum": ["read"] },
              "through": { "type": "string" }
            }
          },
          {
            "type": "object",
            "required": ["is_archived", "is_hidden", "is_manually_unread", "keep_archived", "kind"],
            "properties": {
              "is_archived": { "type": "boolean" },
              "is_hidden": { "type": "boolean" },
              "is_manually_unread": { "type": "boolean" },
              "keep_archived": { "type": "boolean" },
              "kind": { "type": "string", "enum": ["preferences"] },
              "muted_until": { "type": ["string", "null"], "format": "date-time" },
              "pin_rank": { "type": ["integer", "null"], "format": "int32" }
            }
          },
          {
            "type": "object",
            "required": ["kind"],
            "properties": { "kind": { "type": "string", "enum": ["clear"] } }
          },
          {
            "type": "object",
            "required": ["kind"],
            "properties": { "kind": { "type": "string", "enum": ["close"] } }
          },
          {
            "type": "object",
            "required": ["days", "kind"],
            "properties": {
              "days": { "type": "integer", "format": "int32" },
              "kind": { "type": "string", "enum": ["expiry"] }
            }
          },
          {
            "type": "object",
            "required": ["message_id", "expected_version", "content", "kind"],
            "properties": {
              "content": { "$ref": "#/components/schemas/MessageContent" },
              "expected_version": { "type": "string" },
              "kind": { "type": "string", "enum": ["edit"] },
              "message_id": { "type": "string", "format": "uuid" }
            }
          },
          {
            "type": "object",
            "required": ["message_id", "kind"],
            "properties": {
              "kind": { "type": "string", "enum": ["delete"] },
              "message_id": { "type": "string", "format": "uuid" }
            }
          },
          {
            "type": "object",
            "required": ["message_id", "kind"],
            "properties": {
              "kind": { "type": "string", "enum": ["hide_message"] },
              "message_id": { "type": "string", "format": "uuid" }
            }
          },
          {
            "type": "object",
            "required": ["message_id", "emoji", "is_selected", "kind"],
            "properties": {
              "emoji": { "type": "string" },
              "is_selected": { "type": "boolean" },
              "kind": { "type": "string", "enum": ["reaction"] },
              "message_id": { "type": "string", "format": "uuid" }
            }
          },
          {
            "type": "object",
            "required": ["message_id", "is_pinned", "kind"],
            "properties": {
              "is_pinned": { "type": "boolean" },
              "kind": { "type": "string", "enum": ["pin"] },
              "message_id": { "type": "string", "format": "uuid" }
            }
          }
        ]
      },
      "CommandConflict": {
        "type": "object",
        "required": ["error", "current"],
        "properties": {
          "current": { "$ref": "#/components/schemas/CommandReceipt" },
          "error": { "$ref": "#/components/schemas/ErrorDetails" }
        }
      },
      "CommandReceipt": {
        "type": "object",
        "required": ["observation_cursor"],
        "properties": {
          "conversation": {
            "oneOf": [{ "type": "null" }, { "$ref": "#/components/schemas/ConversationView" }]
          },
          "message": {
            "oneOf": [{ "type": "null" }, { "$ref": "#/components/schemas/CanonicalMessage" }]
          },
          "observation_cursor": { "type": "string" }
        }
      },
      "ConversationView": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "peer_id",
          "peer_username",
          "peer_name",
          "last_sequence",
          "version",
          "summary_text",
          "updated_at",
          "generation",
          "unread_count",
          "read_through",
          "clear_through",
          "is_archived",
          "is_hidden",
          "is_manually_unread",
          "keep_archived",
          "expiry_days",
          "peer_read_through",
          "draft"
        ],
        "properties": {
          "clear_through": { "type": "string" },
          "draft": { "$ref": "#/components/schemas/DraftView" },
          "expiry_days": { "type": "integer", "format": "int32" },
          "generation": { "type": "string" },
          "id": { "type": "string", "format": "uuid" },
          "is_archived": { "type": "boolean" },
          "is_hidden": { "type": "boolean" },
          "is_manually_unread": { "type": "boolean" },
          "keep_archived": { "type": "boolean" },
          "kind": { "type": "string" },
          "last_sequence": { "type": "string" },
          "muted_until": { "type": ["string", "null"], "format": "date-time" },
          "peer_id": { "type": "string", "format": "uuid" },
          "peer_name": { "type": "string" },
          "peer_read_through": { "type": "string" },
          "peer_username": { "type": "string" },
          "pin_rank": { "type": ["integer", "null"], "format": "int32" },
          "read_through": { "type": "string" },
          "summary_text": { "type": "string" },
          "unread_count": { "type": "string" },
          "updated_at": { "type": "string", "format": "date-time" },
          "version": { "type": "string" }
        }
      },
      "CustomEmoji": {
        "type": "object",
        "required": ["document_id", "offset", "length"],
        "properties": {
          "document_id": { "type": "string" },
          "length": { "type": "integer", "format": "int32", "minimum": 0 },
          "offset": { "type": "integer", "format": "int32", "minimum": 0 }
        },
        "additionalProperties": false
      },
      "Destination": {
        "oneOf": [
          {
            "type": "object",
            "required": ["user_id", "kind"],
            "properties": {
              "kind": { "type": "string", "enum": ["recipient"] },
              "user_id": { "type": "string", "format": "uuid" }
            }
          },
          {
            "type": "object",
            "required": ["conversation_id", "kind"],
            "properties": {
              "conversation_id": { "type": "string", "format": "uuid" },
              "kind": { "type": "string", "enum": ["conversation"] }
            }
          },
          {
            "type": "object",
            "required": ["kind"],
            "properties": { "kind": { "type": "string", "enum": ["saved"] } }
          }
        ]
      },
      "DeviceRevocation": {
        "type": "object",
        "required": ["session_id"],
        "properties": { "session_id": { "type": "string", "format": "uuid" } },
        "additionalProperties": false
      },
      "DirectoryPage": {
        "type": "object",
        "required": ["users"],
        "properties": {
          "next_cursor": { "type": ["string", "null"] },
          "users": { "type": "array", "items": { "$ref": "#/components/schemas/PublicProfile" } }
        }
      },
      "DraftView": {
        "type": "object",
        "required": ["version"],
        "properties": {
          "content": {
            "oneOf": [{ "type": "null" }, { "$ref": "#/components/schemas/MessageContent" }]
          },
          "reply": { "oneOf": [{ "type": "null" }, { "$ref": "#/components/schemas/ReplyInput" }] },
          "version": { "type": "string" }
        }
      },
      "EmailAddress": {
        "type": "object",
        "required": ["email"],
        "properties": { "email": { "type": "string" } },
        "additionalProperties": false
      },
      "EmailConfirmation": {
        "type": "object",
        "required": ["token"],
        "properties": { "token": { "type": "string" } },
        "additionalProperties": false
      },
      "ErrorDetails": {
        "type": "object",
        "required": ["code", "message", "request_id"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "request_id": { "type": "string" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": { "error": { "$ref": "#/components/schemas/ErrorDetails" } }
      },
      "HealthResponse": {
        "type": "object",
        "required": ["status", "service"],
        "properties": {
          "service": { "$ref": "#/components/schemas/ServiceKind" },
          "status": { "$ref": "#/components/schemas/HealthStatus" }
        }
      },
      "HealthStatus": { "type": "string", "enum": ["ok"] },
      "HistoryPage": {
        "type": "object",
        "required": ["messages", "has_older", "has_newer", "observation_cursor", "generation"],
        "properties": {
          "generation": { "type": "string" },
          "has_newer": { "type": "boolean" },
          "has_older": { "type": "boolean" },
          "messages": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CanonicalMessage" }
          },
          "observation_cursor": { "type": "string" },
          "preceding_message": {
            "oneOf": [{ "type": "null" }, { "$ref": "#/components/schemas/CanonicalMessage" }]
          }
        }
      },
      "Login": {
        "type": "object",
        "required": ["username", "password", "device_name"],
        "properties": {
          "device_name": { "type": "string" },
          "password": { "type": "string" },
          "username": { "type": "string" }
        },
        "additionalProperties": false
      },
      "MessageCommand": {
        "type": "object",
        "required": ["operation_id", "conversation_id", "action"],
        "properties": {
          "action": { "$ref": "#/components/schemas/CommandAction" },
          "conversation_id": { "type": "string", "format": "uuid" },
          "operation_id": { "type": "string", "format": "uuid" }
        },
        "additionalProperties": false
      },
      "MessageContent": {
        "type": "object",
        "required": ["schema_version", "text", "custom_emoji"],
        "properties": {
          "custom_emoji": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CustomEmoji" }
          },
          "rich_text": { "type": ["string", "null"] },
          "schema_version": { "type": "integer", "format": "int32", "minimum": 0 },
          "text": { "type": "string" }
        },
        "additionalProperties": false
      },
      "PasswordProof": {
        "type": "object",
        "required": ["password"],
        "properties": { "password": { "type": "string" } },
        "additionalProperties": false
      },
      "PasswordReplacement": {
        "type": "object",
        "required": ["current_password", "new_password"],
        "properties": {
          "current_password": { "type": "string" },
          "new_password": { "type": "string" }
        },
        "additionalProperties": false
      },
      "PasswordReset": {
        "type": "object",
        "required": ["token", "new_password"],
        "properties": { "new_password": { "type": "string" }, "token": { "type": "string" } },
        "additionalProperties": false
      },
      "PrivacySettings": {
        "type": "object",
        "required": ["direct_messages", "calls", "presence"],
        "properties": {
          "calls": { "$ref": "#/components/schemas/Audience" },
          "direct_messages": { "$ref": "#/components/schemas/Audience" },
          "presence": { "$ref": "#/components/schemas/Audience" }
        },
        "additionalProperties": false
      },
      "PrivateProfile": {
        "type": "object",
        "required": ["id", "username", "display_name", "biography", "is_operator", "version"],
        "properties": {
          "biography": { "type": "string" },
          "display_name": { "type": "string" },
          "email": { "type": ["string", "null"] },
          "id": { "type": "string", "format": "uuid" },
          "is_operator": { "type": "boolean" },
          "phone": { "type": ["string", "null"] },
          "username": { "type": "string" },
          "version": { "type": "string" }
        }
      },
      "ProfileUpdate": {
        "type": "object",
        "required": ["version", "display_name", "biography"],
        "properties": {
          "biography": { "type": "string" },
          "display_name": { "type": "string" },
          "phone": { "type": ["string", "null"] },
          "version": { "type": "string" }
        },
        "additionalProperties": false
      },
      "PublicProfile": {
        "type": "object",
        "required": ["id", "username", "display_name", "biography"],
        "properties": {
          "biography": { "type": "string" },
          "display_name": { "type": "string" },
          "id": { "type": "string", "format": "uuid" },
          "username": { "type": "string" }
        }
      },
      "ReactionView": {
        "type": "object",
        "required": ["emoji", "count", "is_selected"],
        "properties": {
          "count": { "type": "string" },
          "emoji": { "type": "string" },
          "is_selected": { "type": "boolean" }
        }
      },
      "Registration": {
        "type": "object",
        "required": ["username", "password", "display_name", "device_name"],
        "properties": {
          "device_name": { "type": "string" },
          "display_name": { "type": "string" },
          "password": { "type": "string" },
          "username": { "type": "string" }
        },
        "additionalProperties": false
      },
      "RelationshipTarget": {
        "type": "object",
        "required": ["target_id"],
        "properties": { "target_id": { "type": "string", "format": "uuid" } },
        "additionalProperties": false
      },
      "ReplyInput": {
        "type": "object",
        "required": ["message_id"],
        "properties": {
          "message_id": { "type": "string", "format": "uuid" },
          "quote": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      },
      "ReplyView": {
        "type": "object",
        "required": ["message_id", "is_unavailable"],
        "properties": {
          "is_unavailable": { "type": "boolean" },
          "message_id": { "type": "string", "format": "uuid" },
          "quote": { "type": ["string", "null"] }
        }
      },
      "SendMessage": {
        "type": "object",
        "required": ["operation_id", "message_id", "destination", "content"],
        "properties": {
          "content": { "$ref": "#/components/schemas/MessageContent" },
          "destination": { "$ref": "#/components/schemas/Destination" },
          "draft_version": { "type": ["string", "null"] },
          "message_id": { "type": "string", "format": "uuid" },
          "operation_id": { "type": "string", "format": "uuid" },
          "reply": { "oneOf": [{ "type": "null" }, { "$ref": "#/components/schemas/ReplyInput" }] }
        },
        "additionalProperties": false
      },
      "SendReceipt": {
        "type": "object",
        "required": ["observation_cursor", "message", "conversation"],
        "properties": {
          "conversation": { "$ref": "#/components/schemas/ConversationView" },
          "message": { "$ref": "#/components/schemas/CanonicalMessage" },
          "observation_cursor": { "type": "string" }
        }
      },
      "ServiceKind": { "type": "string", "enum": ["api", "worker"] },
      "SessionView": {
        "type": "object",
        "required": ["id", "device_name", "created_at", "last_seen_at", "expires_at", "is_current"],
        "properties": {
          "created_at": { "type": "string", "format": "date-time" },
          "device_name": { "type": "string" },
          "expires_at": { "type": "string", "format": "date-time" },
          "id": { "type": "string", "format": "uuid" },
          "is_current": { "type": "boolean" },
          "last_seen_at": { "type": "string", "format": "date-time" }
        }
      },
      "SyncGroup": {
        "type": "object",
        "required": ["position", "conversation_id"],
        "properties": {
          "conversation": {
            "oneOf": [{ "type": "null" }, { "$ref": "#/components/schemas/ConversationView" }]
          },
          "conversation_id": { "type": "string", "format": "uuid" },
          "message": {
            "oneOf": [{ "type": "null" }, { "$ref": "#/components/schemas/CanonicalMessage" }]
          },
          "position": { "type": "string" },
          "removed_message_id": { "type": ["string", "null"], "format": "uuid" }
        }
      },
      "SyncPage": {
        "type": "object",
        "required": ["groups", "cursor", "observation_cursor", "has_more"],
        "properties": {
          "cursor": { "type": "string" },
          "groups": { "type": "array", "items": { "$ref": "#/components/schemas/SyncGroup" } },
          "has_more": { "type": "boolean" },
          "observation_cursor": { "type": "string" }
        }
      }
    }
  }
}
